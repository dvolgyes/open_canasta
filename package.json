{
	"name": "open_canasta",
	"version": "0.1.0",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"description": "Four-player partnership canasta in the browser, with tracker, Nostr and MQTT discovery and WebRTC for the game and call.",
	"homepage": "https://dvolgyes.github.io/open_canasta/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dvolgyes/open_canasta.git"
	},
	"bugs": {
		"url": "https://github.com/dvolgyes/open_canasta/issues"
	},
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit -p tsconfig.json && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"bot": "node --env-file-if-exists=.env --import tsx src/bot/cli.ts",
		"test:e2e": "playwright test",
		"test:e2e:live": "E2E_LIVE_OPENROUTER=1 playwright test tests/e2e/live-openrouter.spec.ts"
	},
	"dependencies": {
		"@noble/secp256k1": "3.2.0",
		"@openrouter/agent": "0.11.0",
		"@trystero-p2p/core": "0.26.0",
		"mqtt": "5.16.0",
		"werift": "0.25.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.64.1",
		"@types/node": "22.20.5",
		"@vitest/browser-playwright": "5.0.5",
		"mqtt-packet": "9.0.2",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
